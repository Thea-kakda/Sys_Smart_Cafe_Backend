# Port 5433 is the HOST port published by compose.yaml (container 5432 -> host 5433).
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/smart_coffee
DATABASE_USERNAME=smart_coffee
DATABASE_PASSWORD=smart_coffee

JWT_HMAC_SECRET_BASE64=REPLACE_WITH_BASE64_ENCODED_SECRET

# MinIO object storage. LOCAL DEVELOPMENT placeholders only - change the
# credentials for any shared/production environment and never commit real secrets.
# Docker-to-Docker backend traffic should point MINIO_ENDPOINT at http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smart-coffee-storage

# Exact comma-separated browser origins allowed on the STOMP /ws handshake.
# Defaults cover local dev frontends (Customer 3000, POS 3005) - see application.yml.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://127.0.0.1:3000,http://127.0.0.1:3005

# Bootstrap Super Admin (placeholders only — put real values in the git-ignored .env).
# Password rule matches /auth/register: 10..128 characters. Leave enabled=false outside dev.
BOOTSTRAP_SUPERADMIN_ENABLED=false
BOOTSTRAP_SUPERADMIN_FULL_NAME=Superadmin
BOOTSTRAP_SUPERADMIN_EMAIL=replace-me@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-me-10-chars-min