// SMART Coffee & Bakery Management Platform
// Corrected logical model for architecture approval
// Modular monolith first; cross-schema references become logical references after extraction

Enum user_status { PENDING ACTIVE LOCKED DISABLED }
Enum order_status { RECEIVED AWAITING_PAYMENT CONFIRMED PREPARING READY COMPLETED CANCELLED }
Enum source_type { CUSTOMER_APP CUSTOMER_WEB POS DASHBOARD PARTNER }
Enum order_type { DINE_IN TAKEAWAY }
Enum cart_status { ACTIVE CHECKED_OUT EXPIRED ABANDONED }
Enum selection_type { SINGLE MULTIPLE }
Enum product_availability { AVAILABLE UNAVAILABLE DISCONTINUED }
Enum discount_type { PERCENTAGE FIXED_AMOUNT }
Enum promotion_status { DRAFT ACTIVE PAUSED EXPIRED CANCELLED }
Enum redemption_status { RESERVED APPLIED RELEASED REVERSED }
Enum payment_status { PENDING PARTIALLY_PAID PAID FAILED CANCELLED PARTIALLY_REFUNDED REFUNDED }
Enum payment_attempt_status { CREATED PENDING SUCCEEDED FAILED EXPIRED CANCELLED UNKNOWN }
Enum refund_status { REQUESTED PROCESSING COMPLETED FAILED CANCELLED }
Enum method_type { CASH KHQR CARD WALLET OTHER }
Enum reservation_status { PENDING RESERVED CONSUMED RELEASED EXPIRED FAILED }
Enum transaction_type { STOCK_IN STOCK_OUT ADJUSTMENT DAMAGED SALE_CONSUMPTION RETURN TRANSFER_IN TRANSFER_OUT }
Enum unit_type { WEIGHT VOLUME COUNT OTHER }
Enum delivery_channel { IN_APP PUSH EMAIL }
Enum delivery_status { PENDING PROCESSING DELIVERED FAILED CANCELLED }
Enum idempotency_status { PROCESSING COMPLETED FAILED }
Enum kitchen_ticket_status { QUEUED IN_PREPARATION READY SERVED CANCELLED CANCELLED_WITH_WASTE }
Enum loyalty_entry_type { EARN REDEEM ADJUST EXPIRE REVERSE }

Table identity.users {
  user_id uuid [pk]
  full_name varchar(100) [not null]
  email varchar(320)
  normalized_email varchar(320)
  phone varchar(30)
  normalized_phone varchar(30)
  profile_photo_url text
  date_of_birth date
  preferred_language varchar(10) [not null, default: 'en']
  status user_status [not null, default: 'ACTIVE']
  security_version integer [not null, default: 0]
  email_verified_at timestamptz
  phone_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    normalized_email [unique]
    normalized_phone [unique]
    (status, created_at)
  }
}

Table identity.user_credentials {
  user_id uuid [pk]
  password_hash text [not null]
  password_algorithm varchar(30) [not null, default: 'argon2id']
  password_changed_at timestamptz [not null, default: `now()`]
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table identity.auth_sessions {
  session_id uuid [pk]
  user_id uuid [not null]
  token_family_id uuid [not null]
  refresh_token_hash varchar(128) [not null]
  rotation_counter integer [not null, default: 0]
  device_id varchar(200)
  device_name varchar(200)
  ip_address inet
  user_agent text
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revocation_reason varchar(100)
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    refresh_token_hash [unique]
    (user_id, revoked_at, expires_at)
    token_family_id
  }
}

Table identity.roles {
  role_id uuid [pk]
  role_code varchar(50) [unique, not null]
  role_name varchar(100) [unique, not null]
  description text
  is_system boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table identity.permissions {
  permission_id uuid [pk]
  permission_code varchar(100) [unique, not null]
  resource varchar(60) [not null]
  action varchar(40) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  Indexes { (resource, action) [unique] }
}

Table identity.role_permissions {
  role_id uuid [pk]
  permission_id uuid [pk]
  granted_at timestamptz [not null, default: `now()`]
}

Table identity.user_roles {
  user_role_id uuid [pk]
  user_id uuid [not null]
  role_id uuid [not null]
  store_id uuid
  assigned_by uuid
  assigned_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  revoked_at timestamptz
  Indexes { (user_id, role_id, store_id, revoked_at) }
}

Table identity.staff_profiles {
  staff_id uuid [pk]
  employee_code varchar(40) [unique, not null]
  home_store_id uuid
  hire_date date
  termination_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table store.stores {
  store_id uuid [pk]
  store_code varchar(30) [unique, not null]
  store_name varchar(150) [not null]
  logo_url text
  address text [not null]
  phone varchar(30)
  latitude decimal(9,6)
  longitude decimal(9,6)
  timezone varchar(64) [not null, default: 'Asia/Phnom_Penh']
  default_currency char(3) [not null, default: 'USD']
  allow_negative_stock boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table store.store_opening_hours {
  opening_hours_id uuid [pk]
  store_id uuid [not null]
  day_of_week smallint [not null]
  open_time time
  close_time time
  is_closed boolean [not null, default: false]
  Indexes { (store_id, day_of_week) [unique] }
}

Table customer.customer_profiles {
  customer_id uuid [pk]
  user_id uuid [unique, not null]
  loyalty_number varchar(40) [unique]
  marketing_opt_in boolean [not null, default: false]
  points_balance_cache bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table customer.customer_favorites {
  customer_id uuid [pk]
  product_id uuid [pk]
  created_at timestamptz [not null, default: `now()`]
}

Table customer.customer_consents {
  consent_id uuid [pk]
  customer_id uuid [not null]
  consent_type varchar(50) [not null]
  granted boolean [not null]
  policy_version varchar(30) [not null]
  occurred_at timestamptz [not null, default: `now()`]
  source varchar(30) [not null]
  Indexes { (customer_id, consent_type, occurred_at) }
}

Table customer.loyalty_accounts {
  loyalty_account_id uuid [pk]
  customer_id uuid [unique, not null]
  points_balance bigint [not null, default: 0]
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table customer.loyalty_ledger {
  loyalty_entry_id uuid [pk]
  loyalty_account_id uuid [not null]
  entry_type loyalty_entry_type [not null]
  points_delta bigint [not null]
  order_id uuid
  reference_entry_id uuid
  idempotency_key varchar(200) [not null]
  reason varchar(250)
  occurred_at timestamptz [not null, default: `now()`]
  Indexes { idempotency_key [unique] (loyalty_account_id, occurred_at) }
}

Table catalog.product_categories {
  category_id uuid [pk]
  parent_category_id uuid
  category_code varchar(50) [unique, not null]
  category_name varchar(100) [not null]
  description text
  image_url text
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table catalog.products {
  product_id uuid [pk]
  product_code varchar(50) [unique, not null]
  product_name varchar(150) [not null]
  description text
  image_url text
  category_id uuid [not null]
  base_price decimal(14,4) [not null]
  cost_price decimal(14,4)
  currency_code char(3) [not null, default: 'USD']
  availability_status product_availability [not null, default: 'AVAILABLE']
  preparation_time_minutes integer [not null, default: 0]
  tax_rate decimal(7,4) [not null, default: 0]
  is_customizable boolean [not null, default: false]
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Indexes { (category_id, availability_status) }
}

Table catalog.store_products {
  store_id uuid [pk]
  product_id uuid [pk]
  is_available boolean [not null, default: true]
  sold_out_until timestamptz
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, is_available, sold_out_until) }
}

Table catalog.store_product_prices {
  store_product_price_id uuid [pk]
  store_id uuid [not null]
  product_id uuid [not null]
  amount decimal(14,4) [not null]
  currency_code char(3) [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, product_id, effective_from) [unique] }
}

Table catalog.customization_groups {
  customization_group_id uuid [pk]
  group_code varchar(50) [unique, not null]
  group_name varchar(100) [not null]
  selection_type selection_type [not null]
  min_selections integer [not null, default: 0]
  max_selections integer
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table catalog.customization_options {
  customization_option_id uuid [pk]
  customization_group_id uuid [not null]
  option_code varchar(50) [not null]
  option_name varchar(100) [not null]
  additional_price decimal(14,4) [not null, default: 0]
  display_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (customization_group_id, option_code) [unique] (customization_group_id, customization_option_id) [unique] }
}

Table catalog.product_customization_groups {
  product_id uuid [pk]
  customization_group_id uuid [pk]
  is_required boolean [not null, default: false]
  display_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.product_customization_options {
  product_id uuid [pk]
  customization_group_id uuid [pk]
  customization_option_id uuid [pk]
  price_override decimal(14,4)
  is_default boolean [not null, default: false]
  is_available boolean [not null, default: true]
}

Table promotion.promotions {
  promotion_id uuid [pk]
  promotion_code varchar(50) [unique]
  promotion_name varchar(150) [not null]
  description text
  discount_type discount_type [not null]
  discount_value decimal(14,4) [not null]
  minimum_order_amount decimal(14,4) [not null, default: 0]
  maximum_discount_amount decimal(14,4)
  currency_code char(3)
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  status promotion_status [not null, default: 'DRAFT']
  usage_limit integer
  per_customer_limit integer
  created_by uuid
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table promotion.promotion_products { promotion_id uuid [pk] product_id uuid [pk] }
Table promotion.promotion_categories { promotion_id uuid [pk] category_id uuid [pk] }

Table promotion.promotion_redemptions {
  redemption_id uuid [pk]
  promotion_id uuid [not null]
  order_id uuid [unique, not null]
  customer_id uuid
  status redemption_status [not null]
  discount_amount decimal(14,4) [not null]
  currency_code char(3) [not null]
  reserved_at timestamptz [not null]
  applied_at timestamptz
  released_at timestamptz
  reversed_at timestamptz
  idempotency_key varchar(200) [unique, not null]
  Indexes { (promotion_id, customer_id, status) }
}

Table cart.carts {
  cart_id uuid [pk]
  customer_id uuid [not null]
  store_id uuid [not null]
  status cart_status [not null, default: 'ACTIVE']
  currency_code char(3) [not null, default: 'USD']
  version integer [not null, default: 0]
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (customer_id, store_id, status) }
}

Table cart.cart_items {
  cart_item_id uuid [pk]
  cart_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  unit_base_price_snapshot decimal(14,4) [not null]
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table cart.cart_item_customizations {
  cart_item_customization_id uuid [pk]
  cart_item_id uuid [not null]
  customization_group_id uuid [not null]
  customization_option_id uuid [not null]
  option_name_snapshot varchar(100) [not null]
  additional_price_snapshot decimal(14,4) [not null, default: 0]
  quantity integer [not null, default: 1]
  Indexes { (cart_item_id, customization_option_id) [unique] }
}

Table ordering.orders {
  order_id uuid [pk]
  order_number varchar(40) [not null]
  store_id uuid [not null]
  customer_id uuid
  cart_id uuid
  inventory_reservation_id uuid
  promotion_redemption_id uuid
  source source_type [not null]
  order_type order_type [not null]
  status order_status [not null, default: 'RECEIVED']
  ordered_at timestamptz [not null, default: `now()`]
  requested_pickup_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancellation_reason text
  total_quantity integer [not null]
  subtotal decimal(14,4) [not null]
  discount_amount decimal(14,4) [not null, default: 0]
  tax_amount decimal(14,4) [not null, default: 0]
  rounding_amount decimal(14,4) [not null, default: 0]
  total_amount decimal(14,4) [not null]
  currency_code char(3) [not null]
  notes varchar(1000)
  cashier_user_id uuid
  created_by uuid
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, order_number) [unique] (store_id, status, ordered_at) (customer_id, ordered_at) }
}

Table ordering.order_items {
  order_item_id uuid [pk]
  order_id uuid [not null]
  product_id uuid
  recipe_version_id uuid
  product_code_snapshot varchar(50) [not null]
  product_name_snapshot varchar(150) [not null]
  category_id_snapshot uuid
  quantity integer [not null]
  unit_base_price decimal(14,4) [not null]
  unit_customization_price decimal(14,4) [not null, default: 0]
  unit_discount_amount decimal(14,4) [not null, default: 0]
  line_total decimal(14,4) [not null]
  estimated_unit_cost decimal(14,4)
  note varchar(500)
  created_at timestamptz [not null, default: `now()`]
  Indexes { order_id }
}

Table ordering.order_item_customizations {
  order_item_customization_id uuid [pk]
  order_item_id uuid [not null]
  customization_group_id uuid
  customization_option_id uuid
  group_name_snapshot varchar(100) [not null]
  option_name_snapshot varchar(100) [not null]
  additional_price decimal(14,4) [not null, default: 0]
  quantity integer [not null, default: 1]
}

Table ordering.order_status_history {
  order_status_history_id bigint [pk, increment]
  order_id uuid [not null]
  from_status order_status
  to_status order_status [not null]
  changed_by uuid
  changed_at timestamptz [not null, default: `now()`]
  reason text
  request_id uuid
  Indexes { (order_id, changed_at) }
}

Table payment.payment_methods {
  payment_method_id uuid [pk]
  method_code varchar(30) [unique, not null]
  method_name varchar(100) [not null]
  method_type method_type [not null]
  currency_code char(3)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table payment.payments {
  payment_id uuid [pk]
  payment_reference varchar(60) [unique, not null]
  order_id uuid [not null]
  status payment_status [not null, default: 'PENDING']
  settlement_currency char(3) [not null]
  amount_due decimal(14,4) [not null]
  amount_paid decimal(14,4) [not null, default: 0]
  amount_refunded decimal(14,4) [not null, default: 0]
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (order_id, status) }
}

Table payment.payment_attempts {
  payment_attempt_id uuid [pk]
  payment_id uuid [not null]
  payment_method_id uuid [not null]
  attempt_number integer [not null]
  status payment_attempt_status [not null]
  amount decimal(14,4) [not null]
  settlement_currency char(3) [not null]
  tender_currency char(3) [not null]
  exchange_rate decimal(20,10) [not null, default: 1]
  amount_received decimal(14,4)
  change_amount decimal(14,4) [not null, default: 0]
  provider_code varchar(40)
  provider_reference varchar(150)
  idempotency_key varchar(200) [unique, not null]
  received_by uuid
  failure_code varchar(80)
  failure_message varchar(500)
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  Indexes { (payment_id, attempt_number) [unique] (provider_code, provider_reference) [unique] }
}

Table payment.payment_provider_callbacks {
  callback_id uuid [pk]
  provider_code varchar(40) [not null]
  provider_event_id varchar(200) [not null]
  payment_attempt_id uuid
  signature_valid boolean [not null]
  payload jsonb [not null]
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  processing_error text
  Indexes { (provider_code, provider_event_id) [unique] }
}

Table payment.refunds {
  refund_id uuid [pk]
  refund_reference varchar(60) [unique, not null]
  payment_id uuid [not null]
  status refund_status [not null]
  amount decimal(14,4) [not null]
  currency_code char(3) [not null]
  reason varchar(500) [not null]
  idempotency_key varchar(200) [unique, not null]
  provider_reference varchar(150)
  requested_by uuid
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  version integer [not null, default: 0]
}

Table payment.refund_items {
  refund_item_id uuid [pk]
  refund_id uuid [not null]
  order_item_id uuid
  quantity integer
  amount decimal(14,4) [not null]
}

Table payment.payment_reconciliations {
  reconciliation_id uuid [pk]
  payment_attempt_id uuid [not null]
  provider_status varchar(50)
  result varchar(50) [not null]
  provider_payload jsonb
  checked_at timestamptz [not null, default: `now()`]
  Indexes { (payment_attempt_id, checked_at) }
}

Table payment.receipts {
  receipt_id uuid [pk]
  receipt_number varchar(50) [not null]
  order_id uuid [not null]
  payment_id uuid
  cashier_user_id uuid
  receipt_at timestamptz [not null, default: `now()`]
  object_key text
  payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  Indexes { (order_id, receipt_number) [unique] }
}

Table inventory.units_of_measure {
  unit_id uuid [pk]
  unit_code varchar(20) [unique, not null]
  unit_name varchar(50) [not null]
  unit_type unit_type [not null]
  decimal_scale smallint [not null, default: 3]
}

Table inventory.ingredients {
  ingredient_id uuid [pk]
  ingredient_code varchar(50) [unique, not null]
  ingredient_name varchar(150) [not null]
  unit_id uuid [not null]
  standard_cost decimal(14,4) [not null, default: 0]
  is_perishable boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table inventory.recipe_versions {
  recipe_version_id uuid [pk]
  product_id uuid [not null]
  version_number integer [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  created_at timestamptz [not null, default: `now()`]
  Indexes { (product_id, version_number) [unique] }
}

Table inventory.recipe_version_lines {
  recipe_version_id uuid [pk]
  ingredient_id uuid [pk]
  quantity_required decimal(16,4) [not null]
  wastage_percent decimal(7,4) [not null, default: 0]
}

Table inventory.inventory_balances {
  store_id uuid [pk]
  ingredient_id uuid [pk]
  current_stock decimal(18,4) [not null, default: 0]
  reserved_stock decimal(18,4) [not null, default: 0]
  minimum_stock decimal(18,4) [not null, default: 0]
  average_unit_cost decimal(14,4) [not null, default: 0]
  version integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]
}

Table inventory.inventory_reservations {
  reservation_id uuid [pk]
  store_id uuid [not null]
  order_id uuid [unique, not null]
  status reservation_status [not null]
  expires_at timestamptz
  version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, status, expires_at) }
}

Table inventory.inventory_reservation_lines {
  reservation_line_id uuid [pk]
  reservation_id uuid [not null]
  ingredient_id uuid [not null]
  quantity decimal(18,4) [not null]
  Indexes { (reservation_id, ingredient_id) [unique] }
}

Table inventory.ingredient_lots {
  ingredient_lot_id uuid [pk]
  store_id uuid [not null]
  ingredient_id uuid [not null]
  lot_number varchar(80) [not null]
  received_quantity decimal(18,4) [not null]
  remaining_quantity decimal(18,4) [not null]
  unit_cost decimal(14,4) [not null]
  received_at timestamptz [not null]
  expires_at timestamptz
  supplier_id uuid
  created_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, ingredient_id, lot_number) [unique] (store_id, ingredient_id, expires_at) }
}

Table inventory.stock_transactions {
  stock_transaction_id uuid [pk]
  transaction_number varchar(50) [not null]
  store_id uuid [not null]
  transaction_type transaction_type [not null]
  transaction_at timestamptz [not null, default: `now()`]
  reference_type varchar(30)
  reference_id uuid
  idempotency_key varchar(200) [unique]
  notes text
  recorded_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  Indexes { (store_id, transaction_number) [unique] (store_id, transaction_at) }
}

Table inventory.stock_transaction_lines {
  stock_transaction_line_id uuid [pk]
  stock_transaction_id uuid [not null]
  ingredient_id uuid [not null]
  ingredient_lot_id uuid
  quantity_delta decimal(18,4) [not null]
  unit_cost decimal(14,4)
  reason text
  created_at timestamptz [not null, default: `now()`]
}

Table expense.expense_categories {
  expense_category_id uuid [pk]
  category_code varchar(50) [unique, not null]
  category_name varchar(100) [unique, not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table expense.expenses {
  expense_id uuid [pk]
  expense_number varchar(50) [not null]
  store_id uuid [not null]
  expense_category_id uuid [not null]
  amount decimal(14,4) [not null]
  currency_code char(3) [not null]
  expense_date date [not null]
  description text
  vendor_name varchar(150)
  receipt_object_key text
  recorded_by uuid [not null]
  status varchar(20) [not null, default: 'POSTED']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  voided_at timestamptz
  voided_by uuid
  Indexes { (store_id, expense_number) [unique] (store_id, expense_date) }
}

Table notification.notifications {
  notification_id uuid [pk]
  notification_type varchar(40) [not null]
  title varchar(200) [not null]
  body text [not null]
  image_url text
  action_url text
  related_entity_type varchar(50)
  related_entity_id uuid
  scheduled_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table notification.user_notifications {
  user_notification_id uuid [pk]
  notification_id uuid [not null]
  user_id uuid [not null]
  channel delivery_channel [not null]
  status delivery_status [not null, default: 'PENDING']
  delivered_at timestamptz
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Indexes { (notification_id, user_id, channel) [unique] (user_id, read_at, created_at) }
}

Table notification.notification_delivery_attempts {
  delivery_attempt_id uuid [pk]
  user_notification_id uuid [not null]
  attempt_number integer [not null]
  provider_code varchar(50)
  provider_reference varchar(150)
  status delivery_status [not null]
  error_code varchar(80)
  error_message varchar(500)
  attempted_at timestamptz [not null, default: `now()`]
  next_retry_at timestamptz
  Indexes { (user_notification_id, attempt_number) [unique] (status, next_retry_at) }
}

Table notification.device_tokens {
  device_token_id uuid [pk]
  user_id uuid [not null]
  platform varchar(20) [not null]
  token text [unique, not null]
  is_active boolean [not null, default: true]
  last_seen_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
}

Table setting.system_settings {
  setting_id uuid [pk]
  owner_module varchar(50) [not null]
  store_id uuid
  setting_key varchar(120) [not null]
  setting_value jsonb [not null]
  description text
  is_sensitive boolean [not null, default: false]
  updated_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Indexes { (owner_module, store_id, setting_key) [unique] }
}

Table audit.audit_logs {
  audit_log_id bigint [pk, increment]
  occurred_at timestamptz [not null, default: `now()`]
  actor_user_id uuid
  store_id uuid
  action varchar(40) [not null]
  entity_type varchar(100) [not null]
  entity_id text
  old_values jsonb
  new_values jsonb
  request_id uuid
  correlation_id uuid
  ip_address inet
  user_agent text
  Indexes { occurred_at (actor_user_id, occurred_at) (store_id, occurred_at) }
}

Table integration.api_idempotency_records {
  idempotency_record_id uuid [pk]
  actor_id uuid
  scope varchar(100) [not null]
  idempotency_key varchar(200) [not null]
  request_hash varchar(64) [not null]
  status idempotency_status [not null]
  resource_type varchar(80)
  resource_id uuid
  response_status integer
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  Indexes { (scope, actor_id, idempotency_key) [unique] expires_at }
}

Table integration.outbox_events {
  event_id uuid [pk]
  aggregate_type varchar(80) [not null]
  aggregate_id uuid [not null]
  event_type varchar(120) [not null]
  event_version integer [not null]
  correlation_id uuid
  causation_id uuid
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  published_at timestamptz
  publish_attempts integer [not null, default: 0]
  last_error text
  Indexes { (published_at, occurred_at) (aggregate_id, occurred_at) }
}

Table integration.consumer_inbox {
  consumer_name varchar(100) [pk]
  event_id uuid [pk]
  processed_at timestamptz [not null, default: `now()`]
}

Table kitchen.kitchen_tickets {
  kitchen_ticket_id uuid [pk]
  order_id uuid [unique, not null]
  store_id uuid [not null]
  status kitchen_ticket_status [not null, default: 'QUEUED']
  version integer [not null, default: 0]
  queued_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  ready_at timestamptz
  served_at timestamptz
}

Table kitchen.kitchen_ticket_items {
  kitchen_ticket_item_id uuid [pk]
  kitchen_ticket_id uuid [not null]
  order_item_id uuid [not null]
  status kitchen_ticket_status [not null, default: 'QUEUED']
  station_code varchar(50)
  started_at timestamptz
  ready_at timestamptz
  Indexes { (kitchen_ticket_id, order_item_id) [unique] }
}

// Same-database foreign keys for modular-monolith phase
Ref: identity.user_credentials.user_id > identity.users.user_id
Ref: identity.auth_sessions.user_id > identity.users.user_id
Ref: identity.role_permissions.role_id > identity.roles.role_id
Ref: identity.role_permissions.permission_id > identity.permissions.permission_id
Ref: identity.user_roles.user_id > identity.users.user_id
Ref: identity.user_roles.role_id > identity.roles.role_id
Ref: identity.user_roles.assigned_by > identity.users.user_id
Ref: identity.staff_profiles.staff_id > identity.users.user_id
Ref: identity.user_roles.store_id > store.stores.store_id
Ref: identity.staff_profiles.home_store_id > store.stores.store_id
Ref: store.store_opening_hours.store_id > store.stores.store_id
Ref: customer.customer_profiles.user_id > identity.users.user_id
Ref: customer.customer_favorites.customer_id > customer.customer_profiles.customer_id
Ref: customer.customer_favorites.product_id > catalog.products.product_id
Ref: customer.customer_consents.customer_id > customer.customer_profiles.customer_id
Ref: customer.loyalty_accounts.customer_id > customer.customer_profiles.customer_id
Ref: customer.loyalty_ledger.loyalty_account_id > customer.loyalty_accounts.loyalty_account_id
Ref: customer.loyalty_ledger.reference_entry_id > customer.loyalty_ledger.loyalty_entry_id
Ref: catalog.product_categories.parent_category_id > catalog.product_categories.category_id
Ref: catalog.products.category_id > catalog.product_categories.category_id
Ref: catalog.store_products.store_id > store.stores.store_id
Ref: catalog.store_products.product_id > catalog.products.product_id
Ref: catalog.store_product_prices.store_id > store.stores.store_id
Ref: catalog.store_product_prices.product_id > catalog.products.product_id
Ref: catalog.customization_options.customization_group_id > catalog.customization_groups.customization_group_id
Ref: catalog.product_customization_groups.product_id > catalog.products.product_id
Ref: catalog.product_customization_groups.customization_group_id > catalog.customization_groups.customization_group_id
Ref: catalog.product_customization_options.(product_id, customization_group_id) > catalog.product_customization_groups.(product_id, customization_group_id)
Ref: catalog.product_customization_options.(customization_group_id, customization_option_id) > catalog.customization_options.(customization_group_id, customization_option_id)
Ref: promotion.promotion_products.promotion_id > promotion.promotions.promotion_id
Ref: promotion.promotion_products.product_id > catalog.products.product_id
Ref: promotion.promotion_categories.promotion_id > promotion.promotions.promotion_id
Ref: promotion.promotion_categories.category_id > catalog.product_categories.category_id
Ref: promotion.promotion_redemptions.promotion_id > promotion.promotions.promotion_id
Ref: cart.carts.customer_id > customer.customer_profiles.customer_id
Ref: cart.carts.store_id > store.stores.store_id
Ref: cart.cart_items.cart_id > cart.carts.cart_id
Ref: cart.cart_items.product_id > catalog.products.product_id
Ref: cart.cart_item_customizations.cart_item_id > cart.cart_items.cart_item_id
Ref: ordering.orders.store_id > store.stores.store_id
Ref: ordering.orders.customer_id > customer.customer_profiles.customer_id
Ref: ordering.orders.cart_id > cart.carts.cart_id
Ref: ordering.order_items.order_id > ordering.orders.order_id
Ref: ordering.order_item_customizations.order_item_id > ordering.order_items.order_item_id
Ref: ordering.order_status_history.order_id > ordering.orders.order_id
Ref: payment.payment_attempts.payment_id > payment.payments.payment_id
Ref: payment.payment_attempts.payment_method_id > payment.payment_methods.payment_method_id
Ref: payment.payment_provider_callbacks.payment_attempt_id > payment.payment_attempts.payment_attempt_id
Ref: payment.refunds.payment_id > payment.payments.payment_id
Ref: payment.refund_items.refund_id > payment.refunds.refund_id
Ref: payment.payment_reconciliations.payment_attempt_id > payment.payment_attempts.payment_attempt_id
Ref: payment.receipts.payment_id > payment.payments.payment_id
Ref: inventory.ingredients.unit_id > inventory.units_of_measure.unit_id
Ref: inventory.recipe_versions.product_id > catalog.products.product_id
Ref: inventory.recipe_version_lines.recipe_version_id > inventory.recipe_versions.recipe_version_id
Ref: inventory.recipe_version_lines.ingredient_id > inventory.ingredients.ingredient_id
Ref: inventory.inventory_balances.store_id > store.stores.store_id
Ref: inventory.inventory_balances.ingredient_id > inventory.ingredients.ingredient_id
Ref: inventory.inventory_reservation_lines.reservation_id > inventory.inventory_reservations.reservation_id
Ref: inventory.inventory_reservation_lines.ingredient_id > inventory.ingredients.ingredient_id
Ref: inventory.ingredient_lots.ingredient_id > inventory.ingredients.ingredient_id
Ref: inventory.stock_transaction_lines.stock_transaction_id > inventory.stock_transactions.stock_transaction_id
Ref: inventory.stock_transaction_lines.ingredient_id > inventory.ingredients.ingredient_id
Ref: inventory.stock_transaction_lines.ingredient_lot_id > inventory.ingredient_lots.ingredient_lot_id
Ref: expense.expenses.expense_category_id > expense.expense_categories.expense_category_id
Ref: notification.user_notifications.notification_id > notification.notifications.notification_id
Ref: notification.notification_delivery_attempts.user_notification_id > notification.user_notifications.user_notification_id
Ref: kitchen.kitchen_ticket_items.kitchen_ticket_id > kitchen.kitchen_tickets.kitchen_ticket_id
